datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["tracing"]
}

model Conversation {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  unread    Boolean @default(false)
  source    String  @default("core")
  incognito Boolean @default(false)

  asyncJobId String?

  title  String?

  status         String  @default("pending")
  activeStreamId String?

  ConversationHistory ConversationHistory[]
  knowledgeCaptureBatches KnowledgeCaptureBatch[]
  RecallLog           RecallLog[]
}

model CompactedSessionEmbedding {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vector   Unsupported("vector")
  summary  String
  metadata Json?

  @@map("compacted_session_embeddings")
}

model ConversationHistory {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  message  String
  parts    Json?
  userType UserType

  context Json?
  thoughts Json?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sortOrder  Int?
}

enum KnowledgeCaptureBatchStatus {
  PROPOSED
  ARCHIVED
}

enum KnowledgeCaptureItemKind {
  ENTITY
  RELATION
  EVENT
  DECISION
}

enum KnowledgeCaptureItemStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  SNOOZED
  MERGED
}

enum RejectReason {
  INACCURATE
  IRRELEVANT
  DUPLICATE
  TRIVIAL
  OTHER
}

model KnowledgeCaptureBatch {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sessionId String
  summary   String
  status    KnowledgeCaptureBatchStatus @default(PROPOSED)

  sourceEpisodeUuids String[] @default([])

  items KnowledgeCaptureItem[]

  @@index([conversationId])
  @@index([sessionId])
}

model KnowledgeCaptureItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batchId String
  batch   KnowledgeCaptureBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  kind       KnowledgeCaptureItemKind
  title      String
  payload    Json
  evidence   Json?
  confidence Float?
  importance Float?

  firstSeenAt    DateTime
  lastSeenAt     DateTime
  lastReviewedAt DateTime?
  status         KnowledgeCaptureItemStatus @default(PROPOSED)

  acceptedGraphUuid String?
  mergeTargetUuid   String?

  rejectReason RejectReason?
  reviewNotes  String?

  @@index([batchId, status])
  @@index([kind, status])
  @@index([acceptedGraphUuid])
}

model Document {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  sessionId String?

  title       String
  content     String
  labelIds    String[]
  source      String
  metadata    Json?
  type        String
  version     Int      @default(1)
  contentHash String?
  chunkHashes String[]

  editedBy String

  @@unique([sessionId])
  @@index([sessionId])
}

model EntityEmbedding {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name     String
  vector   Unsupported("vector")
  metadata Json?

  @@map("entity_embeddings")
}

model LabelEmbedding {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  description String?
  vector      Unsupported("vector")
  metadata    Json?

  @@map("label_embeddings")
}

model EpisodeEmbedding {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content         String
  vector          Unsupported("vector")
  labelIds        String[]
  metadata        Json?
  sessionId       String
  originalContent String?
  chunkIndex      Int?
  chunkHash       String?
  version         Int?

  ingestionQueueId String
  ingestionQueue   IngestionQueue @relation(fields: [ingestionQueueId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, version])
  @@map("episode_embeddings")
}

model IngestionQueue {
  id String @id @default(cuid())

  data     Json
  output   Json?
  status   IngestionStatus
  priority Int     @default(0)

  source    String?
  title     String?
  sessionId String?
  type      String?

  graphIds  String[] @default([])
  labels    String[] @default([])
  favourite Boolean  @default(false)

  error      String?
  retryCount Int     @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  episodeEmbeddings EpisodeEmbedding[]

  @@index([sessionId])
  @@index([sessionId, createdAt(sort: Desc)])
}

model IngestionRule {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  name     String?
  text     String
  source   String
  isActive Boolean @default(true)
}

model Label {
  id          String  @id @default(cuid())
  name        String
  description String?
  color       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecallLog {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  accessType String
  query      String?
  targetType String?
  targetId   String?

  searchMethod  String?
  minSimilarity Float?
  maxResults    Int?

  resultCount     Int    @default(0)
  similarityScore Float?

  context   String?
  source    String?
  sessionId String?
  responseTimeMs Int?

  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String?

  metadata Json? @default("{}")
}

model Reminder {
  id               String    @id @default(uuid())
  text             String
  schedule         String
  startDate        DateTime?
  nextRunAt        DateTime?
  maxOccurrences   Int?
  occurrenceCount  Int       @default(0)
  endDate          DateTime?
  channel          String    @default("whatsapp")
  isActive         Boolean   @default(true)
  confirmedActive  Boolean   @default(false)
  unrespondedCount Int       @default(0)
  lastSentAt       DateTime?
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([isActive])
  @@index([nextRunAt])
}

model StatementEmbedding {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fact     String
  vector   Unsupported("vector")
  labelIds String[]
  metadata Json?

  @@map("statement_embeddings")
}

model VoiceAspect {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fact         String
  aspect       String
  episodeUuids String[]

  validAt       DateTime  @default(now())
  invalidAt     DateTime?
  invalidatedBy String?

  @@index([aspect])
  @@index([invalidAt])
  @@map("voice_aspects")
}

model VoiceAspectEmbedding {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fact     String
  aspect   String
  vector   Unsupported("vector")
  metadata Json?

  @@map("voice_aspect_embeddings")
}

enum TaskStatus {
  Todo
  Waiting
  Ready
  Working
  Review
  Done
  Recurring
}

model Task {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?
  status      TaskStatus @default(Todo)

  conversationIds String[]

  result String?
  error  String?

  jobId    String?
  metadata Json?   @default("{}")

  schedule         String?
  nextRunAt        DateTime?
  lastRunAt        DateTime?
  occurrenceCount  Int       @default(0)
  maxOccurrences   Int?
  isActive         Boolean   @default(true)
  startDate        DateTime?
  endDate          DateTime?
  confirmedActive  Boolean   @default(false)
  unrespondedCount Int       @default(0)

  channel String?

  parentTaskId String?
  parentTask   Task?   @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks     Task[]  @relation("TaskSubtasks")

  displayId String?

  pageId String? @unique
  page   Page?   @relation("TaskPage", fields: [pageId], references: [id], onDelete: SetNull)
  source String  @default("manual")

  @@unique([displayId])
  @@index([status])
  @@index([nextRunAt])
  @@index([isActive])
  @@index([parentTaskId])
}

enum PageType {
  Daily
  Task
}

model Page {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   DateTime?

  type              PageType  @default(Daily)
  date              DateTime?
  description       String?
  descriptionBinary Bytes?
  butlerLastSeen    Bytes?
  outlinks          Json?     @default("[]")

  task   Task? @relation("TaskPage")
  butlerComments ButlerComment[]

  @@unique([date])
}

model ButlerComment {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolved   Boolean   @default(false)
  resolvedAt DateTime?

  selectedText   String
  content        String
  relativeStart  Json?
  relativeEnd    Json?

  pageId         String
  conversationId String?

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, resolved])
}

enum IngestionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  NO_CREDITS
}

enum UserType {
  Agent
  User
  System
}

// ---------------------------------------------------------------------------
// LLM Providers & Models
// ---------------------------------------------------------------------------

model LLMProvider {
  id          String     @id @default(uuid())
  name        String
  type        String
  config      Json       @default("{}")
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  models      LLMModel[]

  @@index([type])
}

model LLMModel {
  id            String      @id @default(uuid())
  providerId    String
  provider      LLMProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  modelId       String
  label         String
  complexity    String
  supportsBatch Boolean     @default(true)
  isEnabled     Boolean     @default(true)
  isDeprecated  Boolean     @default(false)
  capabilities  String[]
  dimensions    Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([providerId])
  @@index([complexity])
}

// ---------------------------------------------------------------------------
// Wiki Entries
// ---------------------------------------------------------------------------

enum WikiEntryStatus {
  DRAFT
  PUBLISHED
  REJECTED
}

model WikiEntry {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entityUuid String
  title      String
  definition String
  summary    String
  content    String

  status     WikiEntryStatus @default(DRAFT)
  reviewedAt DateTime?

  rejectReason RejectReason?
  reviewNotes  String?

  versions WikiEntryVersion[]

  @@index([entityUuid])
  @@unique([entityUuid])
}

model WikiEntryVersion {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  wikiEntryId String
  wikiEntry   WikiEntry @relation(fields: [wikiEntryId], references: [id], onDelete: Cascade)

  version    Int
  title      String
  definition String
  summary    String
  content    String

  sourceEpisodeUuid String?

  @@index([wikiEntryId, version])
}
model BlockedKeyword {
  id        String   @id @default(cuid())
  word      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blocked_keywords")
}
