{
  "name": "@core/core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./conversation": {
      "types": "./dist/conversation.d.ts",
      "import": "./dist/conversation.js",
      "default": "./dist/conversation.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "import": "./dist/document.js",
      "default": "./dist/document.js"
    },
    "./tag": {
      "types": "./dist/tag.d.ts",
      "import": "./dist/tag.js",
      "default": "./dist/tag.js"
    },
    "./wiki": {
      "types": "./dist/wiki.d.ts",
      "import": "./dist/wiki.js",
      "default": "./dist/wiki.js"
    },
    "./knowledge": {
      "types": "./dist/knowledge.d.ts",
      "import": "./dist/knowledge.js",
      "default": "./dist/knowledge.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js",
      "default": "./dist/search.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && tsc --noEmit false --outDir dist --declaration",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --noEmit false --outDir dist --declaration --watch"
  },
  "dependencies": {
    "@core/database": "workspace:*",
    "@core/providers": "workspace:*",
    "@core/types": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "rimraf": "6.0.1",
    "typescript": "5.5.4"
  }
}
