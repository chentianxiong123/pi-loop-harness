VERSION=0.7.3

# PostgreSQL with pgvector
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=docker
POSTGRES_PASSWORD=docker
POSTGRES_DB=memorynote
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}?schema=memorynote
DIRECT_URL=${DATABASE_URL}

# App
REMIX_APP_PORT=3033
APP_ENV=production
NODE_ENV=${APP_ENV}
APP_ORIGIN=http://localhost:3033
LOGIN_ORIGIN=http://localhost:3033

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=docker1234

# OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_MODE=chat_completions

# Default models
MODEL=gpt-5.2-2025-12-11
EMBEDDING_MODEL=mxbai-embed-large
EMBEDDING_MODEL_SIZE=1024

# Provider routing
CHAT_PROVIDER=openai

# Reranking (optional)
RERANK_PROVIDER=none

# Provider configuration
GRAPH_PROVIDER=neo4j
VECTOR_PROVIDER=pgvector
MODEL_PROVIDER=vercel-ai
