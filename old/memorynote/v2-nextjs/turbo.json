{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "interactive": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate:deploy": {
      "cache": false
    },
    "db:migrate:create": {
      "cache": false,
      "interactive": true
    },
    "db:studio": {
      "cache": false
    },
    "db:reset": {
      "interactive": true,
      "cache": false
    },
    "generate": {
      "dependsOn": ["^generate"]
    },
    "start": {
      "cache": false
    }
  },
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DIRECT_URL",
    "APP_ENV",
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "MODEL",
    "EMBEDDING_MODEL",
    "EMBEDDING_MODEL_SIZE",
    "EMBEDDING_API_KEY"
  ]
}
